# Host directory containing WEIGHTS_FILE. Paths are relative to convert/docker/.
WEIGHTS_DIR=../work
WEIGHTS_FILE=best.pt

# INT8 calibration images. First-level subdirectories are treated as classes.
CALIB_DIR=../work/dataset
CALIB_NUM=200

# Generated ONNX, RKNN, dataset lists and JSON manifests.
OUTPUT_DIR=../work/output

IMAGE_NAME=rknn-convert:1.5.0-slim
PLATFORM=rk3588
INPUT_SIZE=640
QUANTIZED=INT8
HEAD_MODE=slim
OPTIMIZATION_LEVEL=3
OPSET=12
SEED=42
